gba(215,175,51,0.1);padding:4px 10px;border-radius:999px;font-family:'JetBrains Mono',monospace\\\">SEO fundamentals</span>\\n    <span style=\\\"font-size:11px;color:#D7AF33;background:rgba(215,175,51,0.1);padding:4px 10px;border-radius:999px;font-family:'JetBrains Mono',monospace\\\">Page-speed signals</span>\\n    <span style=\\\"font-size:11px;color:#D7AF33;background:rgba(215,175,51,0.1);padding:4px 10px;border-radius:999px;font-family:'JetBrains Mono',monospace\\\">Funnel wiring</span>\\n  </div>\\n  <div style=\\\"display:flex;gap:8px\\\">\\n    <input data-pmc-aw-input type=\\\"url\\\" placeholder=\\\"yourwebsite.com\\\" spellcheck=\\\"false\\\" style=\\\"flex:1;min-width:0;background:rgba(4,13,13,0.7);border:1px solid rgba(245,240,232,0.15);border-radius:11px;padding:14px;color:#F5F0E8;font-family:'JetBrains Mono',monospace;font-size:13px;outline:none\\\">\\n    <button data-pmc-aw-submit type=\\\"button\\\" style=\\\"background:#D7AF33;color:#15110A;border:none;border-radius:11px;padding:0 22px;font-weight:700;font-family:'Satoshi',sans-serif;cursor:pointer;font-size:14px;white-space:nowrap\\\">Find the leak</button>\\n  </div>\\n  <div data-pmc-aw-stream style=\\\"margin-top:4px\\\"></div>\\n  <div data-pmc-aw-capture style=\\\"display:none;margin-top:18px;padding-top:18px;border-top:1px solid rgba(245,240,232,0.085)\\\">\\n    <div data-pmc-aw-capture-state=\\\"idle\\\">\\n      <div style=\\\"font-size:14px;color:rgba(245,240,232,0.9);font-weight:500;margin-bottom:12px;line-height:1.4\\\">Want Joe to walk you through these findings on a 30-min call?</div>\\n      <form data-pmc-aw-capture-form style=\\\"display:flex;gap:8px;flex-wrap:wrap;position:relative\\\" novalidate>\\n        <input type=\\\"email\\\" data-pmc-aw-capture-email name=\\\"email\\\" required placeholder=\\\"your@email.com\\\" autocomplete=\\\"email\\\" style=\\\"flex:1;min-width:180px;background:rgba(4,13,13,0.7);border:1px solid rgba(245,240,232,0.15);border-radius:11px;padding:12px 14px;color:#F5F0E8;font-size:13px;outline:none\\\">\\n        <input type=\\\"text\\\" data-pmc-aw-capture-honeypot name=\\\"website_url\\\" tabindex=\\\"-1\\\" autocomplete=\\\"off\\\" aria-hidden=\\\"true\\\" style=\\\"position:absolute;left:-9999px;width:1px;height:1px;opacity:0\\\">\\n        <button type=\\\"submit\\\" data-pmc-aw-capture-submit style=\\\"background:#D7AF33;color:#15110A;border:none;border-radius:11px;padding:12px 20px;font-weight:700;font-family:'Satoshi',sans-serif;cursor:pointer;font-size:14px\\\">Send to Joe</button>\\n      </form>\\n    </div>\\n    <div data-pmc-aw-capture-state=\\\"submitting\\\" style=\\\"display:none;font-size:14px;color:#D7AF33\\\">Sending...</div>\\n    <div data-pmc-aw-capture-state=\\\"success\\\" style=\\\"display:none;font-size:14px;color:#5FA354;font-weight:600\\\">Joe will follow up within 48 hours.</div>\\n    <div data-pmc-aw-capture-state=\\\"error\\\" style=\\\"display:none\\\">\\n      <div style=\\\"display:flex;align-items:center;gap:8px;font-size:14px;color:#d95252\\\">\\n        <span data-pmc-aw-capture-error-msg style=\\\"flex:1\\\">Something went wrong. Please try again.</span>\\n        <button type=\\\"button\\\" data-pmc-aw-capture-retry style=\\\"background:transparent;border:0;color:#D7AF33;cursor:pointer;font-weight:600;font-size:13px\\\">Try again</button>\\n      </div>\\n    </div>\\n  </div>\\n</div>\"},{\"key\":\"attributes\",\"value\":[{\"name\":\"hidden\",\"value\":\"hidden\"},{\"name\":\"aria-hidden\",\"value\":\"true\"},{\"name\":\"data-pmc-preserved-source\",\"value\":\"services-legacy-hero-audit\"}]}]}}]}"
