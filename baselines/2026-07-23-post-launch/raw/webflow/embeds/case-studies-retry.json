          "type": "text",
          "text": "{\"label\":\"embed-1\",\"action\":\"get_settings\",\"result\":[{\"status\":\"success\",\"message\":\"Settings retrieved\",\"data\":{\"type\":\"all_raw_settings\",\"total_matches\":4,\"matches\":[{\"key\":\"domId\",\"value\":\"\"},{\"key\":\"visibility\",\"value\":true},{\"key\":\"code\",\"value\":\"<div class=\\\"pmc-fcb-wrap\\\">\\n  <div class=\\\"pmc-fcb-banner\\\">\\n    <div class=\\\"pmc-fcb-content\\\">\\n      <div class=\\\"pmc-fcb-tag\\\">\\n        <span class=\\\"pmc-fcb-pulse\\\"></span>\\n        <span class=\\\"pmc-fcb-tag-text\\\">LIMITED AVAILABILITY</span>\\n      </div>\\n      <h3 class=\\\"pmc-fcb-headline\\\">Founding client rates are still open.</h3>\\n      <p class=\\\"pmc-fcb-sub\\\">Premium-level work, founder-led execution, and a system you'll own. These spots will disappear fast.</p>\\n    </div>\\n    <div class=\\\"pmc-fcb-cta\\\">\\n      <a href=\\\"#csa-intake-form\\\" class=\\\"pmc-fcb-btn\\\">\\n        Get Started\\n        <svg width=\\\"14\\\" height=\\\"14\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\\n          <path d=\\\"M7 17l9.2-9.2M7 7h10v10\\\"/>\\n        </svg>\\n      </a>\\n    </div>\\n  </div>\\n</div>\"},{\"key\":\"attributes\",\"value\":[]}]}}]}"
